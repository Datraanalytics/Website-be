# Server-side deployment environment for docker-compose.
# Copy to `.env` on the server (NEXT TO docker-compose.yml) and fill in real
# values. docker-compose injects these into the backend container.
# NEVER commit the real .env — it is git-ignored.

# ---- Database (required) ----
DB_HOST=your-db-host.rds.amazonaws.com
DB_PORT=3306
DB_NAME=website
DB_USER=admin
DB_PASSWORD=your_db_password

# ---- API ----
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=False
